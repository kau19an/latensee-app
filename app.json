{
  "expo": {
    "name": "Latensee",
    "slug": "latensee-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.latensee.app",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.latensee.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Latensee usa sua localização aproximada só no aparelho, para escolher o ponto de medição mais próximo. Ela não é enviada para a API.",
          "isIosReducedAccuracyByDefault": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4672747f-4065-47f5-86e3-969b8575ae44"
      }
    }
  }
}
